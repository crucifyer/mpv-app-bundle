import sys
import os
import subprocess
from Cocoa import NSObject, NSApplication, NSMenu, NSMenuItem
from PyObjCTools import AppHelper

MPV_PATH = "/opt/homebrew/bin/mpv"

def process_path(raw_path):
    final_path = raw_path
    if final_path.startswith("mpv://"):
        final_path = final_path.replace("mpv://", "file://", 1)
    os.environ["MPV_HOME"] = os.path.expanduser("~/.config/mpv")
    subprocess.run([MPV_PATH, "--player-operation-mode=pseudo-gui", final_path])

class AppDelegate(NSObject):
    def application_openFiles_(self, app, filenames):
        for f in filenames:
            process_path(f)

    def application_openURLs_(self, app, urls):
        for url in urls:
            process_path(url.absoluteString())

    def terminate_(self, sender):
        NSApplication.sharedApplication().terminate_(self)

if __name__ == "__main__":
    delegate = AppDelegate.alloc().init()
    app = NSApplication.sharedApplication()
    app.setDelegate_(delegate)

    mainMenu = NSMenu.alloc().init()
    appMenuItem = NSMenuItem.alloc().init()
    mainMenu.addItem_(appMenuItem)
    app.setMainMenu_(mainMenu)

    appMenu = NSMenu.alloc().initWithTitle_("Application")
    quitItem = NSMenuItem.alloc().initWithTitle_action_keyEquivalent_("Quit", "terminate:", "q")
    appMenu.addItem_(quitItem)
    appMenuItem.setSubmenu_(appMenu)

    AppHelper.runEventLoop()